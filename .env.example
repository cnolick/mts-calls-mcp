MTS_CLIENT_PFX_FILE=/var/lib/mts-calls-mcp/production-modern.pfx
MTS_CLIENT_PFX_PASSWORD_FILE=/var/lib/mts-calls-mcp/production-modern.passphrase
MTS_MCP_TOKEN_FILE=/var/lib/mts-calls-mcp/mcp-token
MTS_MCP_PORT=28981
